# Copy this file to .env and fill in your own MongoDB Atlas connection
# string. .env is gitignored — never commit real credentials.
#
# Used by `netlify dev` to run the serverless functions locally.
# In production, set the same variable in the Netlify dashboard:
# Site settings -> Environment variables.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medispract?retryWrites=true&w=majority
